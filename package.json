{
  "name": "autoai",
  "version": "0.0.0",
  "private": true,
  "description": "Desktop app that finds spec-vs-code mismatches, generates Playwright tests, runs them and explains failures.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/core",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "coverage:scope": "node scripts/check-coverage-scope.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deps:check": "depcruise src --config .dependency-cruiser.cjs",
    "deps:selftest": "node scripts/deps-selftest.mjs",
    "tokens:check": "node scripts/check-design-tokens.mjs",
    "lock:check": "node scripts/check-lockfile.mjs",
    "lock:selftest": "node scripts/lock-selftest.mjs",
    "verify": "npm run lock:check && npm run lock:selftest && npm run format:check && npm run typecheck && npm run lint && npm run deps:check && npm run deps:selftest && npm run tokens:check && npm run test:coverage && npm run coverage:scope"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.0",
    "@vitest/coverage-v8": "5.0.2",
    "dependency-cruiser": "18.4.0",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.2"
  },
  "dependencies": {
    "zod": "4.6.5"
  }
}
