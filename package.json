{
  "name": "autoai",
  "version": "0.0.0",
  "private": true,
  "description": "Desktop app that finds spec-vs-code mismatches, generates Playwright tests, runs them and explains failures.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/core && tsc --noEmit -p src/ui",
    "lint": "eslint . --max-warnings 0",
    "requirements": "node src/cli/extract-requirements.ts",
    "scan": "node src/cli/scan.ts",
    "generate-tests": "node src/cli/generate-tests.ts",
    "run-test": "node src/cli/run-test.ts",
    "diagnose": "node src/cli/diagnose.ts",
    "app": "node scripts/build-electron.mjs --dev",
    "app:build": "node scripts/build-electron.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "coverage:scope": "node scripts/check-coverage-scope.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deps:check": "depcruise src --config .dependency-cruiser.cjs",
    "deps:selftest": "node scripts/deps-selftest.mjs",
    "tokens:check": "node scripts/check-design-tokens.mjs",
    "lock:check": "node scripts/check-lockfile.mjs",
    "lock:selftest": "node scripts/lock-selftest.mjs",
    "verify": "npm run lock:check && npm run lock:selftest && npm run format:check && npm run typecheck && npm run lint && npm run deps:check && npm run deps:selftest && npm run tokens:check && npm run tokens:selftest && npm run stories:check && npm run stories:selftest && npm run test:coverage && npm run coverage:scope",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o dist/storybook",
    "stories:check": "node scripts/check-stories.mjs",
    "stories:selftest": "node scripts/stories-selftest.mjs",
    "tokens:selftest": "node scripts/tokens-selftest.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-themes": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.2",
    "dependency-cruiser": "18.4.0",
    "electron": "44.5.1",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "30.1.1",
    "prettier": "3.9.9",
    "storybook": "10.6.1",
    "tailwindcss": "4.3.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.129.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@playwright/test": "1.63.0",
    "@radix-ui/react-checkbox": "1.3.11",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-tooltip": "1.2.16",
    "lucide-react": "1.49.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3",
    "zod": "4.6.5"
  },
  "main": "dist/app/main.js"
}
